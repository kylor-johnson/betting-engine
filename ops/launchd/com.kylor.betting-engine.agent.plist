<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kylor.betting-engine.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>--project</string><string>/Users/kylorjohnson/Library/Mobile Documents/com~apple~CloudDocs/Bettng Model</string>
    <string>engine</string><string>agent</string><string>--reason</string><string>scheduled run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>UV_PROJECT_ENVIRONMENT</key><string>/Users/kylorjohnson/Library/Mobile Documents/com~apple~CloudDocs/Bettng Model/.venv.nosync</string>
    <key>PATH</key><string>/Users/kylorjohnson/.nvm/versions/node/v25.2.1/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/kylorjohnson</string>
  </dict>
  <!-- Local (Mountain) time. Weekday: 0 = Sunday. -->
  <!-- Must match config.yaml agent.schedule (research 22, finding 10): 8:15 every day, plus 6:45 pm Sunday. The hourly read also starts
       any slot that has not run, so this job is the backstop for hours with no read. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/kylorjohnson/Library/Logs/betting-engine/agent.log</string>
  <key>StandardErrorPath</key><string>/Users/kylorjohnson/Library/Logs/betting-engine/agent.err.log</string>
</dict>
</plist>
